ADAFRUIT_AIO_USERNAME=
ADAFRUIT_AIO_KEY=
PORT=5001
MODEL_PATH=/app/models/yolov8n.onnx
CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO
ALLOWED_CLASSES=book,laptop,chair,bottle,backpack,cell phone
ORT_INTRA_THREADS=
WEB_CONCURRENCY=2
DATABASE_PATH=/app/data/guardian.db

# Required for Grafana; no default password. Never commit .env.
GRAFANA_ADMIN_PASSWORD=
SCAN_INFECTED_MIN=1
SCAN_INFECTED_POOL=cell phone,laptop,chair
SCAN_INFECTED_MAX=2
SCAN_SESSION_TTL_MINUTES=15
